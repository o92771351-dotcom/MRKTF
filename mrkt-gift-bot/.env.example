# ============================================================================
#  MRKT Gift Monitor Bot — пример конфигурации
#  Скопируйте в .env и заполните:  cp .env.example .env
#  НИКОГДА не коммитьте .env в git (он уже в .gitignore).
# ============================================================================

# --- Telegram-бот (обязательно) --------------------------------------------
# Токен от @BotFather
BOT_TOKEN=1234567890:AAA-replace-me

# Доступ. Пусто = бот открыт для всех. Заполните ID через запятую, чтобы
# ограничить доступ (свои ID можно узнать у @userinfobot).
ALLOWED_USER_IDS=
ADMIN_USER_IDS=

# --- Источник данных -------------------------------------------------------
# demo  — встроенный демонстрационный генератор (работает без ключей,
#         все карточки помечаются как ТЕСТОВЫЕ ДАННЫЕ)
# mrkt  — реальный приватный API MRKT (нужен MRKT_TOKEN, см. README)
SOURCE=demo

# База MRKT. Проверено 27.10.2026: без валидного токена эндпоинты данных
# отдают HTTP 404, а /auth — HTTP 403 "Forbid 1".
MRKT_BASE_URL=https://api.tgmrkt.io/api/v1
MRKT_REFERER=https://cdn.tgmrkt.io/

# Токен MRKT. Получается ТОЛЬКО через вход реального Telegram-аккаунта
# в мини-приложение @mrkt (POST /auth с initData). Инструкция: README, раздел 5.
MRKT_TOKEN=

# Авто-обновление токена через пользовательскую сессию Telegram (нужен telethon).
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=mrkt_service
TG_SESSION_WORKDIR=./sessions

# Лимиты вежливости к MRKT (площадка отвечает HTTP 429 при частых запросах).
MRKT_REQUEST_DELAY=2.0
MRKT_PAGE_SIZE=20
MRKT_MAX_PAGES=5
MRKT_TIMEOUT=20
MRKT_MAX_RETRIES=3
MRKT_RETRY_BACKOFF_BASE=2.0
MRKT_RETRY_BACKOFF_MAX=15.0

# Шаблон ссылки в кнопке «Открыть предложение».
# ВАЖНО: публичного deep-link на конкретный лот MRKT не обнаружено.
# Формат НЕ подтверждён — проверьте его сами в приложении MRKT
# (лот -> «Поделиться» -> скопировать ссылку) и подставьте сюда.
# Доступные плейсхолдеры: {id} {collection} {model} {backdrop} {symbol} {number}
MRKT_LINK_TEMPLATE=https://t.me/mrkt/app

# Префикс CDN для ключей картинок (MRKT отдаёт относительные пути).
MRKT_CDN_URL=https://cdn.tgmrkt.io/
# ВАЖНО (проверено 27.10.2026 живым токеном): если collectionNames пуст,
# API возвращает total=0 и пустую выдачу. Для запроса «весь рынок» бот
# перебирает коллекции; это лимит коллекций за один цикл (защита от 429).
MRKT_MAX_COLLECTIONS=12

# --- Публичный API @GiftChanges (api.changes.tg) ---------------------------
# Не требует ключей. Даёт цвета фонов (для монохрома), PNG моделей (анализ
# цвета), редкости и fallback-картинки. Требует видимого кредита в боте
# (команда /credits) — это условие использования API.
CHANGES_API_ENABLED=true
CHANGES_API_URL=https://api.changes.tg
CHANGES_CACHE_TTL=86400
CHANGES_REQUEST_DELAY=0.4

# --- Мониторинг ------------------------------------------------------------
POLL_TICK_SECONDS=20
DEFAULT_INTERVAL_MINUTES=15
MIN_INTERVAL_MINUTES=5
MAX_RESULTS_PER_RUN=5
SEND_DELAY_SECONDS=1.2

# Повторная отправка того же лота, если цена снизилась не менее чем на X %.
RESEND_PRICE_DROP_PERCENT=5.0
# Повторная отправка, если лот пропал из выдачи и вернулся через N часов.
RESEND_AFTER_HOURS=24

# --- Оценка выгоды ---------------------------------------------------------
VALUE_MIN_COMPARABLES=3
VALUE_PEER_LOOKBACK_DAYS=3

# --- Ранжирование (веса 0..1, нормируются автоматически) -------------------
# Формула: score = 100 * Σ(w_i * c_i) / Σ(w_i)
RANK_WEIGHT_MATCH=0.25
RANK_WEIGHT_MONOCHROME=0.25
RANK_WEIGHT_VALUE=0.25
RANK_WEIGHT_CONFIDENCE=0.15
RANK_WEIGHT_FRESHNESS=0.10
RANK_FRESHNESS_HALF_LIFE_HOURS=12
DEFAULT_MIN_RELEVANCE=60

# --- Монохром по умолчанию -------------------------------------------------
# gray | dark | light | custom
MONO_MODE_DEFAULT=gray
MONO_MAX_SATURATION=0.12
MONO_MIN_SCORE=60
# Значения по умолчанию для режима custom: целевой тон (0..360) и допуск (1..180).
# Пусто = тон не задан, фильтр работает как обычный «серый».
# Пользователь может переопределить их в боте для каждого фильтра отдельно.
MONO_CUSTOM_HUE=
MONO_CUSTOM_HUE_TOLERANCE=25
MONO_IMAGE_ENABLED=true
MONO_IMAGE_ANALYSIS_TIMEOUT=15
# Разрешить определение «на глаз» по названию (всегда помечается как
# low confidence). true — только если других данных нет.
MONO_ALLOW_NAME_HEURISTIC=true

# --- Хранилище -------------------------------------------------------------
# SQLite (MVP):
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# PostgreSQL (продакшн) — раскомментируйте и установите asyncpg:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mrkt_bot
DB_ECHO=false

# --- Прочее ----------------------------------------------------------------
LOG_LEVEL=INFO
DATA_DIR=./data
CACHE_DIR=./data/cache
IMAGE_ENABLED=true
IMAGE_MAX_BYTES=4000000
IMAGE_SIZE=512
